{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run bandit:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(uv run python scripts/:*)",
      "Bash(uv build:*)",
      "Bash(pnpm -C frontend lint:*)",
      "Bash(pnpm -C frontend test:*)",
      "Bash(pnpm -C frontend typecheck:*)",
      "Bash(pnpm -C frontend build:*)",
      "Bash(pnpm -C frontend format:*)",
      "Bash(pnpm -C frontend gen:contract:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh api:*)",
      "Bash(uv publish:*)",
      "Bash(twine:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
